{
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "../../scripts/prepare_tauri_resources.sh",
    "devPath": "http://localhost:5173",
    "distDir": "../ui/dist"
  },
  "package": {
    "productName": "p2pchat",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "p2pchat",
        "width": 1240,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:* http://127.0.0.1:* http://* https://* ws://* wss://*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.p2pchat.desktop",
      "icon": [
        "icons/icon.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "../../../core/storage/schema.sql",
        "resources"
      ]
    }
  }
}
